# Example local environment file
# Copy this to .env.local and update with your machine's IP address

# Use this when you want others on your network to access the admin panel
REACT_APP_API_BASE_URL=http://192.168.1.187:8080

# Instructions:
# 1. Copy this file to .env.local
# 2. Run 'ipconfig' to find your IPv4 Address
# 3. Replace 192.168.1.187 with your actual IP address
# 4. Restart the dev server (npm start)

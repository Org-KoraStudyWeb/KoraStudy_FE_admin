# API Configuration
REACT_APP_API_URL=http://localhost:8080

# TinyMCE API Key (Required for rich text editor)
# Get your free API key at: https://www.tiny.cloud/auth/signup/
# IMPORTANT: Add your Azure domain to TinyMCE's approved domains list
REACT_APP_TINYMCE_API_KEY=your-tinymce-api-key-here

# Other API Keys (add as needed)
# REACT_APP_OTHER_API_KEY=your-api-key-here
